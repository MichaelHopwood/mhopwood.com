---
import Layout from '../layouts/Layout.astro';
import NoteCard from '../components/NoteCard.astro';
import notes from '../data/notes.json';
const selected=['bootstrapping','scaling-graph-neural-networks','contextualbandits','nn-learning'].map(s=>notes.find(n=>n.slug===s));
---
<Layout><main id="main">
<section class="home-hero page-width"><div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span> APPLIED SCIENTIST · SEATTLE</p><h1>Building systems.<br/>Understanding<br/><em>the ideas behind them.</em></h1><p class="hero-intro">I’m Michael. I work on applied machine learning, from agentic systems and search to graph learning and physical systems.</p><p class="muted">Currently at Amazon. Previously at Microsoft, Tesla, and Sandia National Laboratories.</p><div class="hero-actions"><a class="button" href="/notes/">Explore the notes <span>↗</span></a><a class="text-link" href="/about/">A little about me →</a></div></div>
<div class="hero-visual" aria-label="Illustration connecting mathematical ideas to machine learning"><div class="visual-label">THE WORKING NOTEBOOK <span>№ 001—044</span></div><svg viewBox="0 0 440 340" role="img" aria-label="A network of interconnected ideas"><defs><pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="0.8" fill="#b9bbaa"/></pattern></defs><rect width="440" height="340" fill="url(#grid)"/><g stroke="#87957b" stroke-width="1.1"><path d="M95 155L188 75L315 120L340 250L210 270L95 155L315 120L210 270L188 75L340 250M188 75L210 170L315 120M95 155L210 170L340 250M210 170L210 270" fill="none"/></g><g fill="#f6f5ef" stroke="#355242" stroke-width="2"><circle cx="95" cy="155" r="10"/><circle cx="188" cy="75" r="7"/><circle cx="315" cy="120" r="12"/><circle cx="340" cy="250" r="7"/><circle cx="210" cy="270" r="9"/></g><circle cx="210" cy="170" r="24" fill="#dce59b" stroke="#355242" stroke-width="1.5"/><text x="210" y="177" text-anchor="middle" font-family="Georgia" font-style="italic" font-size="24" fill="#253c32">f(x)</text><g fill="#53604f" font-family="monospace" font-size="10"><text x="38" y="132">PROBABILITY</text><text x="162" y="48">INTUITION</text><text x="325" y="100">LEARNING</text><text x="318" y="280">SYSTEMS</text><text x="142" y="303">EXPERIMENTS</text></g></svg><div class="visual-foot"><span>Ideas connect.<br/><strong>Understanding compounds.</strong></span><span class="mini-mark">∑</span></div></div></section>
<div class="section-divider page-width"><span>A PERSONAL COLLECTION, ALWAYS EVOLVING</span><span>↓ KEEP EXPLORING</span></div>
<section class="page-width home-notes"><div class="section-head"><div><p class="eyebrow">THE NOTEBOOK</p><h2>Learn it. Write it down.<br/><em>Come back to it.</em></h2></div><div class="section-aside"><p>Derivations, code, and intuition collected through research and practice. Organized to help you follow an idea wherever it leads.</p><a class="text-link" href="/notes/">Browse all {notes.length} entries →</a></div></div><div class="note-grid">{selected.map(note=><NoteCard note={note}/>)}</div></section>
<section class="work-strip page-width"><div><p class="eyebrow">IN PRACTICE</p><h2>Ideas, out in the world.</h2><p>Selected work across language models, graph learning, and scientific machine learning.</p></div><a class="button secondary" href="/projects/">Selected projects ↗</a></section>
</main></Layout>
